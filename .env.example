# Copia este archivo como ".env" y ajusta los valores.
# Si tu contraseña tiene caracteres especiales (@ : / #), codifícalos (p.ej. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@localhost:5432/vialidad
MODEL_PATH=models/best.pt
STORAGE_DIR=storage
DEVICE=cpu
MAX_UPLOAD_MB=15
TIMEZONE=America/Guayaquil

# --- Video ---
MAX_VIDEO_MB=500
VIDEO_MAX_FRAMES=300        # límite por defecto (en pantalla se puede subir hasta VIDEO_MAX_FRAMES_CAP)
#VIDEO_MAX_FRAMES_CAP=6000
#VIDEO_CRF=23               # calidad del video anotado: más alto = archivo más liviano

# --- Sensibilidad ---
# "Normal" usa 0.25 (Ultralytics). "Sensible" ya viene CALIBRADO por defecto (0,11–0,17 según la clase).
# Solo si repites la calibración (calibracion/calibracion_sensibilidad.ipynb), pega aquí la línea que imprime:
#PERFIL_SENSIBLE={"conf":0.11,"conf_clase":{"longitudinal_crack":0.16,"transverse_crack":0.17,"alligator_crack":0.11,"pothole":0.14},"imgsz":640,"augment":false}

# --- Acceso desde el celular (opcional pero recomendado si abres el servidor a tu wifi) ---
# Si lo defines, /api y /media exigen esta clave (cookie). En la app Android se escribe en «Clave de acceso».
# Usa algo largo y sin espacios. Viaja SIN cifrar por HTTP: úsalo solo en una red wifi de confianza.
#APP_TOKEN=cambia-esto-por-una-clave-larga
